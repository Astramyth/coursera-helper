{
  "manifest_version": 3,
  "name": "Course Helper",
  "version": "1.0.0",
  "description": "Mark videos and readings complete, answer discussion prompts, and export quiz questions to Markdown.",
  "permissions": ["scripting", "storage", "downloads"],
  "host_permissions": ["https://www.coursera.org/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open Course Helper",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://www.coursera.org/learn/*"],
    "js": ["quiz.js", "content.js"],
    "run_at": "document_idle"
  }]
}
